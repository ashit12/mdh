# ── Build artefacts ───────────────────────────────────────────────────────────
build/
build-*/
out/
cmake-build-*/          # CLion default build dirs
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json

# Static / shared libs and object files
*.a
*.so
*.so.*
*.dylib
*.o
*.obj

# Generated event files (feed_generator output, replay scratch input)
*.bin

# ── IDE & editor ──────────────────────────────────────────────────────────────
# Track project-wide clangd/IntelliSense config; ignore personal/generated files
.vscode/*
!.vscode/c_cpp_properties.json
!.vscode/settings.json
.idea/
*.xcodeproj/
*.xcworkspace/
*.suo
*.user
*.sln.docstates
.vs/

# clangd / LSP
.cache/
.clangd/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Bench output ──────────────────────────────────────────────────────────────
# Machine-local captures from bench_capacity / matching memory / workload
# runs. Durable numbers belong in docs/, not these dumps.
bench-results/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
*.tmp
*.swp
*~
